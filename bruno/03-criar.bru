meta {
  name: Criar produto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/produtos
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Caderno",
    "descricao": "Caderno pautado de 80 folhas",
    "precoCentavos": 1590,
    "estoque": 12
  }
}

tests {
  test("Responde HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("Retorna o produto criado e seu ID", function () {
    const produto = res.getBody();
    expect(produto.id).to.be.a('number').and.be.above(0);
    expect(produto).to.include({ nome: 'Caderno', precoCentavos: 1590, estoque: 12 });
    expect(res.getHeader('location')).to.equal('/produtos/' + produto.id);
    bru.setVar('produtoId', String(produto.id));
  });
}
