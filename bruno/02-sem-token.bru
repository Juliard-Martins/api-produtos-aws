meta {
  name: Bloquear sem token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/produtos
  body: none
  auth: none
}

tests {
  test("Responde HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("Explica a falha de autenticação", function () {
    expect(res.getBody().erro).to.equal('Token ausente ou inválido.');
  });
}
